{
  "tree-guard": [
    "tools/tree-check.mjs",
    "tools/link-check.mjs"
  ],
  "verify-engine": [
    "standard/scripts/self-verify.mjs",
    { "glob": "standard/standard.manifest.json", "couples": "shape" }
  ],
  "web-surface": [
    "tools/docsite.mjs",
    "tools/site-check.mjs",
    "site/**"
  ],
  "spec-engine": [
    "standard/scripts/spec/**",
    "standard/.claude/skills/spec-*/**"
  ],
  "work-cycles": [
    "standard/scripts/cycle-guard.mjs",
    "standard/docs/cycles/**",
    "standard/.claude/skills/cycle-*/**"
  ]
}
