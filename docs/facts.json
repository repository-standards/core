[
  {
    "id": "spec-rules",
    "what": "how many numbered rules SPEC.md defines - the page said R1-R24 while defining R25",
    "home": {
      "countMatches": {
        "file": "standard/SPEC.md",
        "pattern": "^- \\*\\*R\\d+\\.\\*\\*"
      }
    },
    "claims": [
      {
        "file": "standard/SPEC.md",
        "pattern": "Rules are numbered R1-R(\\d+)"
      }
    ]
  },
  {
    "id": "shipped-skills",
    "what": "how many lifecycle skills ship in the tree",
    "home": {
      "count": "standard/.claude/skills/*/SKILL.md"
    },
    "claims": [
      {
        "file": "AGENTS.md",
        "pattern": "`\\.claude/skills/` \\((\\d+) lifecycle skills\\)"
      },
      {
        "file": "AGENTS.md",
        "pattern": "the (\\d+) under `standard/\\.claude/skills/`"
      },
      {
        "file": "backlog.md",
        "pattern": "not the count - (\\d+) ship today"
      },
      {
        "file": "docs/open-questions/shipped-skills.md",
        "pattern": "Currently (\\d+) ship into every adopted repo"
      }
    ]
  },
  {
    "id": "repo-slug",
    "what": "the GitHub path a client degits the tree from",
    "home": {
      "match": {
        "file": "README.md",
        "pattern": "npx degit (\\S+?)(?:/standard)? "
      }
    },
    "claims": [
      {
        "file": "README.md",
        "pattern": "npx degit (\\S+?)(?:/standard)? "
      },
      {
        "file": "llms.txt",
        "pattern": "npx degit (\\S+?)(?:/standard)?[ `\\n]"
      },
      {
        "file": "AGENTS.md",
        "pattern": "npx degit\\n(\\S+?)(?:/standard)?`"
      },
      {
        "file": "docs/quick-start.md",
        "pattern": "npx degit (\\S+?)(?:/standard)?[ \\n]"
      }
    ]
  },
  {
    "id": "standard-version",
    "what": "the version the standard currently ships",
    "home": {
      "read": "VERSION"
    },
    "claims": [
      {
        "file": "standard/SPEC.md",
        "pattern": "^Version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "docs/method/self-verify.md",
        "pattern": "self-verify\\.mjs --version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "standard/scripts/self-verify.mjs",
        "pattern": "self-verify\\.mjs --version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "site/index.html",
        "pattern": "class=\"tag mono\">v(\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "standard/standard.manifest.json",
        "pattern": "\"version\": \"(\\d+\\.\\d+\\.\\d+)\""
      },
      {
        "file": "README.md",
        "pattern": "^\\*\\*(\\d+\\.\\d+\\.\\d+)\\*\\* - the first stable line"
      },
      {
        "file": "docs/faq.md",
        "pattern": "The standard is at (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "llms.txt",
        "pattern": "^- \\*\\*(\\d+\\.\\d+\\.\\d+), still the first stable line"
      },
      {
        "file": "site/llms.txt",
        "pattern": "^- \\*\\*(\\d+\\.\\d+\\.\\d+), still the first stable line"
      }
    ]
  },
  {
    "id": "validation-total-cases",
    "what": "how many cases the validation suite's catalogue carries",
    "home": {
      "match": {
        "file": "docs/validation/ai-prompting/counts.json",
        "pattern": "\"totalCases\": (\\d+)"
      }
    },
    "claims": [
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "Cases in the catalogue \\| \\*\\*(\\d+)\\*\\*"
      }
    ]
  },
  {
    "id": "validation-portable-cases",
    "what": "how many of the validation suite's cases are portable - offered as the benchmark subset",
    "home": {
      "match": {
        "file": "docs/validation/ai-prompting/counts.json",
        "pattern": "\"portableCases\": (\\d+)"
      }
    },
    "claims": [
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "Portable cases \\(the benchmark subset\\) \\| \\*\\*(\\d+)\\*\\*"
      },
      {
        "file": "docs/validation/ai-prompting/benchmark.md",
        "pattern": "checks - \\*\\*(\\d+)\\*\\*, precisely"
      }
    ]
  },
  {
    "id": "validation-total-observations",
    "what": "how many case/target observations the validation suite has recorded, across every round in runs/",
    "home": {
      "match": {
        "file": "docs/validation/ai-prompting/counts.json",
        "pattern": "\"totalObservations\": (\\d+)"
      }
    },
    "claims": [
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "Observations recorded \\| \\*\\*(\\d+)\\*\\*"
      }
    ]
  },
  {
    "id": "validation-total-targets",
    "what": "how many repositories and fixtures the validation suite has run cases against",
    "home": {
      "match": {
        "file": "docs/validation/ai-prompting/counts.json",
        "pattern": "\"totalTargets\": (\\d+)"
      }
    },
    "claims": [
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "Targets assessed \\| \\*\\*(\\d+)\\*\\*"
      },
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "\\*\\*(\\d+)\\*\\* \\(\\d+ real repositories"
      }
    ]
  },
  {
    "id": "validation-repos-tested",
    "what": "how many real (non-fixture) repositories the validation suite has assessed",
    "home": {
      "match": {
        "file": "docs/validation/ai-prompting/counts.json",
        "pattern": "\"reposTested\": (\\d+)"
      }
    },
    "claims": [
      {
        "file": "docs/validation/ai-prompting/README.md",
        "pattern": "\\((\\d+) real repositories"
      }
    ]
  },
  {
    "id": "node-runtime-version",
    "what": "the Node version the dependency-free guards are pinned to - stated in the shipped .nvmrc and restated by every workflow that installs Node",
    "home": {
      "match": {
        "file": "standard/.nvmrc",
        "pattern": "^(\\d+\\.\\d+\\.\\d+)"
      }
    },
    "claims": [
      {
        "file": "standard/.github/workflows/spec-guard.yml",
        "pattern": "node-version: \"(\\d+\\.\\d+\\.\\d+)\""
      },
      {
        "file": ".github/workflows/checks.yml",
        "pattern": "node-version: \"(\\d+\\.\\d+\\.\\d+)\""
      },
      {
        "file": ".github/workflows/pages.yml",
        "pattern": "node-version: \"(\\d+\\.\\d+\\.\\d+)\""
      }
    ]
  },
  {
    "id": "scale-profile-entries",
    "what": "how many manifest entries the scale profile adds - the size of the discount the profile picker offers a core adopter (ADR-040). The home pattern is anchored at entry indentation so the manifest's own top-level profile key is not counted as one of them",
    "home": {
      "countMatches": {
        "file": "standard/standard.manifest.json",
        "pattern": "^      \"profile\": \"scale\",$"
      }
    },
    "claims": [
      {
        "file": "docs/method/adoption.md",
        "pattern": "many entries it skipped, and today the answer is (\\d+)"
      },
      {
        "file": "docs/faq.md",
        "pattern": "it is (\\d+) manifest entries, not a different standard"
      },
      {
        "file": "docs/open-questions/profiles.md",
        "pattern": "on the tree: (\\d+) entries are `scale`"
      },
      {
        "file": "backlog.md",
        "pattern": "too weak to carry the weight - (\\d+) entries"
      }
    ]
  }
]
