[
  {
    "id": "shipped-skills",
    "what": "how many lifecycle skills ship in the tree",
    "home": {
      "count": "standard/.claude/skills/*/SKILL.md"
    },
    "claims": [
      {
        "file": "AGENTS.md",
        "pattern": "`\\.claude/skills/` \\((\\d+) lifecycle skills\\)"
      },
      {
        "file": "AGENTS.md",
        "pattern": "the (\\d+) under `standard/\\.claude/skills/`"
      },
      {
        "file": "docs/open-questions/README.md",
        "pattern": "not the count - (\\d+) ship today"
      },
      {
        "file": "docs/open-questions/shipped-skills.md",
        "pattern": "Currently (\\d+) ship into every adopted repo"
      }
    ]
  },
  {
    "id": "repo-slug",
    "what": "the GitHub path a client degits the tree from",
    "home": {
      "match": {
        "file": "README.md",
        "pattern": "npx degit (\\S+?)(?:/standard)? "
      }
    },
    "claims": [
      {
        "file": "README.md",
        "pattern": "npx degit (\\S+?)(?:/standard)? "
      },
      {
        "file": "llms.txt",
        "pattern": "npx degit (\\S+?)(?:/standard)?[ `\\n]"
      },
      {
        "file": "AGENTS.md",
        "pattern": "npx degit\\n(\\S+?)(?:/standard)?`"
      }
    ]
  },
  {
    "id": "standard-version",
    "what": "the version the standard currently ships",
    "home": {
      "read": "VERSION"
    },
    "claims": [
      {
        "file": "standard/SPEC.md",
        "pattern": "^Version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "docs/method/self-verify.md",
        "pattern": "self-verify\\.mjs --version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "standard/scripts/self-verify.mjs",
        "pattern": "self-verify\\.mjs --version (\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "site/index.html",
        "pattern": "class=\"tag mono\">v(\\d+\\.\\d+\\.\\d+)"
      },
      {
        "file": "standard/standard.manifest.json",
        "pattern": "\"version\": \"(\\d+\\.\\d+\\.\\d+)\""
      }
    ]
  }
]
