    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "fastify": "5.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
