{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.2"
  },
  "scripts": {
    "check:all": "turbo run check:format check:types check:lint",
    "check:format": "turbo run check:format",
    "check:types": "turbo run check:types",
    "check:lint": "turbo run check:lint",
    "format": "biome format --write . && pnpm format:styles",
    "format:styles": "prettier --write \"**/*.scss\"",
    "check:format:styles": "prettier --check \"**/*.scss\"",
    "lint": "biome check .",
    "build": "turbo run build",
    "test:unit": "turbo run test:unit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "prettier": "3.8.5",
    "turbo": "2.10.0",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
