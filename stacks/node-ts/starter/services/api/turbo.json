{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // This service runs TypeScript natively on Node 24+ (no dist emit) - build is the
      // typecheck. Declare no outputs so turbo does not warn about missing artifacts.
      // When you containerize and want a dist/, flip tsconfig to emit and restore
      // the root task's outputs.
      "outputs": []
    }
  }
}
