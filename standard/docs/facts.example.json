[
  {
    "id": "supported-node",
    "what": "the Node version this repo builds and runs on",
    "home": { "match": { "file": ".nvmrc", "pattern": "^(\\d+\\.\\d+\\.\\d+)" } },
    "claims": [
      { "file": "README.md", "pattern": "requires Node (\\d+\\.\\d+\\.\\d+)" },
      { "file": "CONTRIBUTING.md", "pattern": "install Node (\\d+\\.\\d+\\.\\d+)" }
    ]
  },
  {
    "id": "shipped-services",
    "what": "how many services this monorepo deploys",
    "home": { "count": "services/*/service.json" },
    "claims": [{ "file": "ARCHITECTURE.md", "pattern": "(\\d+) deployable services" }]
  },
  {
    "id": "http-error-codes",
    "what": "how many error codes the API contract declares - a count of what one file says, not of files",
    "home": { "countMatches": { "file": "specs/api/spec.md", "pattern": "^\\| `E-\\d+`" } },
    "claims": [{ "file": "docs/integration.md", "pattern": "all (\\d+) error codes" }]
  }
]
