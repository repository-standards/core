{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -rF *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partition*)",
      "Bash(shred *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(killall *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(npm publish *)",
      "Bash(npm publish)",
      "Bash(pnpm publish *)",
      "Bash(pnpm publish)",
      "Bash(pg_restore *)",
      "Bash(prisma migrate *)",
      "Bash(prisma db push *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db push *)",
      "Bash(drizzle-kit *)",
      "Bash(npx drizzle-kit *)",
      "Bash(knex migrate*)",
      "Bash(npx knex migrate*)",
      "Bash(node-pg-migrate *)",
      "Bash(npx node-pg-migrate *)",
      "Bash(typeorm migration*)",
      "Bash(npx typeorm migration*)",
      "Bash(kysely migrate*)",
      "Bash(npx kysely migrate*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(docker system prune)",
      "Bash(fly deploy *)",
      "Bash(fly deploy)",
      "Bash(flyctl deploy *)",
      "Bash(fly secrets set *)",
      "Bash(fly secrets unset *)",
      "Bash(fly ssh console *)",
      "Bash(flyctl ssh console *)",
      "Bash(cdk deploy *)",
      "Bash(cdk destroy *)",
      "Bash(npx cdk deploy *)",
      "Bash(npx cdk destroy *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws ecs update-service *)",
      "Bash(psql *)",
      "Bash(psql)",
      "Bash(pgcli *)",
      "Bash(pg_dump *)",
      "Bash(pg_dumpall *)",
      "Bash(fly postgres *)",
      "Bash(flyctl postgres *)",
      "Bash(fly pg *)",
      "Bash(flyctl pg *)",
      "Bash(fly mpg *)",
      "Bash(flyctl mpg *)",
      "Bash(fly proxy *)",
      "Bash(flyctl proxy *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(brew uninstall *)",
      "Bash(launchctl *)",
      "Bash(crontab *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-remote-db-writes.sh",
            "statusMessage": "Checking remote-database guard"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-force-push.sh",
            "statusMessage": "Checking force-push guard"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-ci-secret-writes.sh",
            "statusMessage": "Checking CI secrets guard"
          }
        ]
      }
    ]
  }
}
